DEMO_MODE=false
LOG_REDACTION=true
OUTPUT_DIR=outputs
FFMPEG_PATH=ffmpeg

# Azure AI Video Indexer. Supply an account access token; tokens are never logged.
VIDEO_INDEXER_ACCOUNT_ID=
VIDEO_INDEXER_LOCATION=
# Optional when using passwordless Entra authentication.
VIDEO_INDEXER_ACCOUNT_RESOURCE_ID=
# Optional fallback. Prefer VIDEO_INDEXER_ACCOUNT_RESOURCE_ID with `az login`.
VIDEO_INDEXER_ACCESS_TOKEN=

# Optional HTTP classifier accepting multipart form field "audio".
EXTERNAL_CLASSIFIER_ENDPOINT=
EXTERNAL_CLASSIFIER_API_KEY=

# Azure OpenAI audio-capable deployment. Deployment name is intentionally configurable.
AZURE_OPENAI_ENDPOINT=
# Optional fallback. Prefer passwordless Entra authentication with `az login`.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_AUDIO_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
GPT_AUDIO_WINDOW_SECONDS=10
GPT_AUDIO_OVERLAP_SECONDS=2
